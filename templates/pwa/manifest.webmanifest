{
  "id": "/",
  "name": "FAMIVERSE",
  "short_name": "FAMIVERSE",
  "description": "{% if request.LANGUAGE_CODE == 'ar' %}تطبيق عائلي ثنائي اللغة{% else %}Application familiale bilingue{% endif %}",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f3f1fa",
  "theme_color": "#21143f",
  "lang": "{{ request.LANGUAGE_CODE }}",
  "dir": "{{ ui_direction }}",
  "icons": [
    {
      "src": "/static/pwa/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/static/pwa/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ]
}
